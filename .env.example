# caro5m — SECRETOS. Copia a .env (chmod 600) o créalo con el asistente del panel (tecla [A]).
# NUNCA subas este fichero relleno a Git. El .env real está en .gitignore.
#
# Para el modo PRUEBA (por defecto) no hace falta nada de esto.

# Clave privada de la cuenta que FIRMA (la clave de tu cuenta Polymarket / el propietario del Safe), formato 0x + 64 hex.
POLY_PRIVATE_KEY=

# Dirección del Safe/proxy que tiene los fondos en Polymarket (la «dirección de depósito»; la ves en tu perfil).
POLY_SAFE_ADDRESS=

# Opcional: proxy HTTP/SOCKS para redes u operadores que bloquean el DNS o restringen el tráfico de salida.
# Formato http://usuario:clave@host:puerto. También https://, socks5:// o socks5h://
# (el asistente acepta además host:puerto:usuario:clave y lo guarda normalizado).
# Con cualquier proxy, el DNS de polymarket.com lo resuelve el proxy en órdenes y claves.
# Varios separados por coma: se usa el primero, en el orden configurado. Vacío = sin proxy.
# No lo uses para eludir las restricciones geográficas de Polymarket: debes cumplir sus condiciones de uso y la ley de tu país.
# Más fácil: panel [A] Cuenta o `python -m caro5m.setup` (lo prueba por ti).
POLYMARKET_PROXY_LIST=

# Credenciales CLOB L2. Las genera el asistente (panel [A] Cuenta o `python -m caro5m.setup`) a partir de tu clave;
# si faltan, el bot las deriva solo al pasar a modo real. No las edites a mano salvo que ya las tengas.
POLY_CLOB_API_KEY=
POLY_CLOB_API_SECRET=
POLY_CLOB_API_PASSPHRASE=

# Número de «nonce» de la clave CLOB (lo gestiona el asistente: «Regenerar» lo incrementa y así invalida las anteriores).
POLY_CLOB_NONCE=
