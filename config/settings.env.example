# caro5m — ajustes NO secretos. El panel ([C] Ajustes) los edita y el bot los aplica en caliente
# en unos segundos, sin reiniciar (los marcados «reiniciar» necesitan reiniciar: el panel lo avisa y [R] lo hace).
# Copia a config/settings.env para cambiarlos.
# Prioridad: variable de entorno > este fichero > valor por defecto.

# Modo AL ARRANCAR: 1 = PRUEBA (simula, no envía órdenes). 0 = ÓRDENES REALES con dinero real.
# Con el bot en marcha el modo solo se cambia con [M] (recargar este fichero nunca lo cambia).
DRY_RUN=1

BET_SIZE=1.00            # USDC por operación (mínimo 1,00)
TP_OFFSET=0.08           # take-profit: entrada + 0,08
SL_OFFSET=0.20           # stop-loss: entrada - 0,20
CB_LOSSES=2              # pérdidas seguidas que activan el freno
CB_COOLDOWN=3600         # segundos de pausa del freno
MIN_TOKEN=0.45           # rango de precio de compra
MAX_TOKEN=0.70
POSITION_TIMEOUT=360     # segundos máx.; al vencer intenta vender al mejor bid y, si gana, cobrar
AUTO_REDEEM=1            # 1 = cobrar on-chain solo en cartera EOA (en PRUEBA se simula); Safe/email: avisa en el panel

CARO5M_TZ=Europe/Madrid  # zona horaria del reloj del panel
CARO5M_USE_PTB=1         # usa el PTB temprano si el servicio caro5m-ptb corre
AUTO_START_PTB=1         # el panel arranca/para el PTB junto con el bot ([B]/[M])
KEEP_RUNNING_ON_EXIT=0   # 0 = al salir del panel (Q, Ctrl+C, cerrar la terminal) se paran el bot y el PTB; 1 = siguen (servidor/systemd)

# también en caliente (una moneda quitada con posición abierta se sigue gestionando hasta cerrarla):
COINS=btc,eth                          # btc, eth, xrp, sol, doge, bnb, hype, zec (hype/zec: precio de Binance)
# COIN_SCALE=doge:2,hype:1.5           # avanzado: umbrales X veces mayores para esa moneda (vacío = 1)
POLYGON_RPCS=https://polygon-bor-rpc.publicnode.com,https://polygon.drpc.org,https://1rpc.io/matic
BINANCE_HOST=https://api.binance.com   # en EE. UU.: https://api.binance.us

# reiniciar el bot tras cambiarlos (en PRUEBA el tipo de firma se aplica solo):
POLY_SIGNATURE_TYPE=2                  # 0 EOA · 1 proxy de email · 2 Safe
CARO5M_PROXY_SCAN=0                    # 1 = las lecturas (Gamma/libro) también van por el proxy; 0 = solo órdenes y claves
